# Copy to local.properties (git-ignored) and fill in.
# sdk.dir is added automatically by Android Studio.
#
# Leave LLM_API_KEY and LLM_BASE_URL empty to use the offline demo responder.
LLM_BASE_URL=https://api.openai.com/
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# Embeddings model for the Mentor knowledge base (same base URL / key as the chat model).
EMBEDDING_MODEL=text-embedding-3-small

# ---- Release builds only (see docs/RELEASE.md) ----
# Your proxy (server/) — the provider key lives there, never in the APK.
PROXY_BASE_URL=
PROXY_CLIENT_TOKEN=
# Required by Google Play: public privacy policy URL (also shown in Settings)
PRIVACY_POLICY_URL=
# Optional: override where "Report this response" posts (default: PROXY_BASE_URL + /v1/report)
REPORT_URL=
# Optional signing config
RELEASE_STORE_FILE=
RELEASE_STORE_PASSWORD=
RELEASE_KEY_ALIAS=
RELEASE_KEY_PASSWORD=
